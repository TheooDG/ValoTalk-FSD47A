{% extends 'base.html.twig' %}

{% block body %}
    <main>
        <h1>Modifier l'article</h1>

        {{ form_start(form, {'attr': {'class': 'article-form'}}) }}

        {% for field in form.children %}
            {% if field.vars.name != '_token' %}
                <div class="form-group">
                    {{ form_label(field) }}
                    {% if field.vars.required %}
                        <span class="required">*</span>
                    {% endif %}
                    {{ form_widget(field) }}
                    {{ form_errors(field) }}
                </div>
            {% endif %}
        {% endfor %}

        <button class="btn">Mettre à jour</button>

        <a href="{{ path('article_show', {'id': article.id}) }}" class="btn-back">Retour à l'article</a>

        {{ form_end(form) }}
    </main>
{% endblock %}